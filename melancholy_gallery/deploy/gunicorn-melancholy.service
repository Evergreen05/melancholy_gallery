[Unit]
Description=Melancholy Gallery (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/melancholy_gallery
ExecStart=/opt/melancholy_gallery/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/gunicorn-melancholy.sock \
    config.wsgi:application
Restart=always
RestartSec=3
Environment=DJANGO_SETTINGS_MODULE=config.settings

[Install]
WantedBy=multi-user.target
